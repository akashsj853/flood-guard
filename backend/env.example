# FloodGuard AI — backend environment template.
# Copy to `.env` and adjust as needed. NEVER commit your real `.env`.
# (Rename this file to `.env` locally; it is committed as env.example because the
#  project rules forbid committing any .env file.)

# Database: SQLite for development; PostgreSQL for production.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/floodguard
DATABASE_URL=sqlite:///./floodguard.db

# Weather provider. Default is Open-Meteo (no API key required).
# Other providers can be wired behind the WeatherService abstraction.
WEATHER_PROVIDER=openmeteo
JWT_SECRET_KEY=change-this-in-production

# Optional provider API keys (NOT used by Open-Meteo; reserved for future
# providers). Never expose these to the frontend.
# WEATHER_API_KEY=

# API host/port (used by uvicorn).
HOST=0.0.0.0
PORT=8000
